# 复制为 deploy/.env 后填入真实值。严禁把 .env 提交到版本库。

# ---- PostgreSQL ----
POSTGRES_DB=exam
POSTGRES_OWNER_USER=exam_owner
POSTGRES_OWNER_PASSWORD=change-me-owner
POSTGRES_APP_USER=exam_app
POSTGRES_APP_PASSWORD=change-me-app

# ---- PgBouncer（可选）----
# 生产（1000 并发）建议启用：docker compose --profile pgbouncer up -d
# 启用后把下面两项改为 pgbouncer / 6432
PGBOUNCER_PORT=6432
DB_HOST=postgres
DB_PORT=5432
# 应用侧连接池。直连 PG 时按「实例数 × 池大小 ≤ max_connections」算：
# 2 个 API 实例 × 80 = 160，加上 Worker 与运维直连仍在 200 以内。
# 启用 PgBouncer 后事务池复用后端连接，客户端池可以放大到 200。
DB_MAX_POOL_SIZE=80
DB_MIN_POOL_SIZE=10
DB_WORKER_MAX_POOL_SIZE=20

# ---- Redis ----
REDIS_PASSWORD=change-me-redis

# ---- MinIO ----
MINIO_ROOT_USER=exam
MINIO_ROOT_PASSWORD=change-me-minio
# 对象存储镜像。官方 minio/minio 已从 Docker Hub 下架，默认用社区分支 silo。
MINIO_IMAGE=pgsty/silo:RELEASE.2026-11-12T00-00-00Z

# ---- 应用 ----
JWT_ISSUER=exam
JWT_AUDIENCE=exam-web
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
# 生成方式：bash scripts/generate-jwt-key.sh
#
# 私钥注入三选一，优先级：挂载文件 > Base64 单行 > 内联 PEM。
# 推荐 Base64：单行、无转义字符，经 compose / K8s Secret 传递不会变形。
#   JWT_SIGNING_PRIVATE_KEY_PEM_BASE64=<deploy/secrets/jwt-private.pem.b64 的内容>
# 走文件挂载见 deploy/docker-compose.secrets.yml。
JWT_SIGNING_PRIVATE_KEY_PEM_BASE64=
JWT_SIGNING_PRIVATE_KEY_PEM=
JWT_REFRESH_TOKEN_PEPPER=change-me-pepper

# ---- 限流（docs/design/05-api.md §1.5）----
# 请求时读配置，改完即生效，不用重启。
# 登录同时受来源 IP 与账号两个维度约束；保存答案、切屏事件与其它写端点按用户限流。
# 默认的「每 IP 10 次/分钟」是按**每台机器一个局域网地址**定的：
# 局域网部署时每个考场机器各有地址，所以一个 IP 就对应一台机器。
# 只有当考场经同一个 NAT 出口上网（地址被合并成同一个）时才需要调高
# （账号那一档不受影响）。
RATE_LIMITING_LOGIN_PER_IP_PER_MINUTE=10
RATE_LIMITING_LOGIN_PER_ACCOUNT_PER_MINUTE=5
RATE_LIMITING_ANSWERS_PER_USER_PER_MINUTE=120
RATE_LIMITING_FOCUS_EVENTS_PER_USER_PER_MINUTE=120
RATE_LIMITING_WRITES_PER_USER_PER_MINUTE=60
RATE_LIMITING_READS_PER_MINUTE=6000

# ---- 反向代理 ----
# 受信任的代理网段：只有这些网段带来的 X-Forwarded-For 才认（审计与限流都靠它）。
# 留空即可：应用会按**容器自身网段**（compose 网桥）兜底，只有 nginx 与 api 之间那段，
# 考场局域网里的机器直连 API 端口时带的 X-Forwarded-For 不会被采信。
# 反向代理不在容器网段里时才要显式指定，多个网段用逗号隔开，例如 10.0.0.0/8,10.1.0.0/16
FORWARDED_HEADERS_KNOWN_NETWORKS=

# ---- 构建用的国内源（镜像构建时用，不影响运行时）----
# npm 包源（corepack 取 pnpm 版本列表也走它）：国内走 npmmirror。
NPM_REGISTRY=https://registry.npmmirror.com/
COREPACK_NPM_REGISTRY=https://registry.npmmirror.com/
# Alpine 包源（postgres 镜像装 pgBackRest 用）：国内走清华镜像。
ALPINE_MIRROR=mirrors.tuna.tsinghua.edu.cn

# ---- 暴露端口 ----
API_PORT=8080
WEB_PORT=8088
# ---- HTTPS（公测必开）----
# 启用 TLS 覆盖层后，宿主机发布这个端口承载 HTTPS：
#   docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d
# 证书放 deploy/certs/fullchain.pem 与 deploy/certs/privkey.pem（权限 600，不进版本库）。
TLS_PORT=443

# ---- 监控栈（可选）----
# 启用：docker compose --profile monitoring up -d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_PORT=3000
