{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "./admin/src/*"
      ],
      "@exam/shared": [
        "./shared/src/index.ts"
      ],
      "@exam/shared/*": [
        "./shared/src/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
