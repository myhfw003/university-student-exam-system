{
  "name": "@exam/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @exam/student --filter @exam/admin dev",
    "build": "pnpm --filter @exam/student --filter @exam/admin build",
    "test": "pnpm --filter @exam/shared --filter @exam/student --filter @exam/admin test",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @exam/shared --filter @exam/student --filter @exam/admin typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0"
  }
}
