{
  "name": "@exam/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @exam/student --filter @exam/admin dev",
    "build": "pnpm --filter @exam/student build && pnpm --filter @exam/admin build && node scripts/check-build-output.mjs",
    "test": "pnpm --filter @exam/shared --filter @exam/student --filter @exam/admin test",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @exam/shared --filter @exam/student --filter @exam/admin typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke-render.mjs",
    "smoke:preview": "node scripts/smoke-render.mjs --serve-dist",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "e2e:api": "playwright test --project=api"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.65.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0"
  }
}
