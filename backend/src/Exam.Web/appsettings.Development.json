{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=exam;Username=exam_app;Password=exam_app_password",
    "Migration": "Host=localhost;Port=5432;Database=exam;Username=exam_owner;Password=exam_owner_password",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Jwt": {
    "Issuer": "exam",
    "Audience": "exam-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "CORS": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5174" ]
  }
}
