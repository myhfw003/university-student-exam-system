{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Npgsql": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "",
    "Migration": "",
    "Redis": ""
  },
  "ObjectStorage": {
    "Enabled": false,
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "exam-attachments",
    "UseSsl": false,
    "PresignedUrlSeconds": 300,
    "MaxFileSizeBytes": 10485760
  },
  "AiGeneration": {
    "Enabled": true,
    "DefaultProvider": "minimax",
    "Providers": {
      "minimax": {
        "DisplayName": "MiniMax",
        "BaseUrl": "https://api.minimaxi.com/v1",
        "ApiKey": "",
        "DefaultModel": "MiniMax-M3.1-Flash",
        "Models": [
          "MiniMax-M3.1-Flash",
          "MiniMax-M3"
        ],
        "Temperature": 0.7,
        "MaxTokens": 8192,
        "TimeoutSeconds": 300,
        "JsonMode": true
      }
    }
  },
  "Jwt": {
    "Issuer": "exam",
    "Audience": "exam-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "CORS": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "LoginPerIpPerMinute": 10,
    "LoginPerAccountPerMinute": 5,
    "AnswersPerUserPerMinute": 120,
    "FocusEventsPerUserPerMinute": 120,
    "WritesPerUserPerMinute": 60,
    "ReadsPerMinute": 6000
  },
  "ForwardedHeaders": {
    "KnownNetworks": []
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "",
    "ServiceName": "exam-web"
  }
}
