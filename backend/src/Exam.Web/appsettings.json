{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Npgsql": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "",
    "Migration": "",
    "Redis": ""
  },
  "ObjectStorage": {
    "Enabled": false,
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "exam-attachments",
    "UseSsl": false,
    "PresignedUrlSeconds": 300,
    "MaxFileSizeBytes": 10485760
  },
  "Jwt": {
    "Issuer": "exam",
    "Audience": "exam-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "CORS": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "LoginPerIpPerMinute": 10,
    "LoginPerAccountPerMinute": 5,
    "AnswersPerUserPerMinute": 120,
    "FocusEventsPerUserPerMinute": 120,
    "WritesPerUserPerMinute": 60,
    "ReadsPerMinute": 6000
  },
  "ForwardedHeaders": {
    "KnownNetworks": [ "172.16.0.0/12" ]
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "",
    "ServiceName": "exam-web"
  }
}
