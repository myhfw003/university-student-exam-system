{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Npgsql": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Database": "",
    "Migration": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "exam",
    "Audience": "exam-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Seed": {
    "AdminUsername": "admin",
    "AdminPassword": ""
  },
  "Analytics": {
    "IncrementalIntervalMinutes": 5,
    "FullRecalculationIntervalHours": 24
  },
  "Metrics": {
    "Port": 9090
  },
  "Reconciliation": {
    "IntervalMinutes": 10,
    "LookbackHours": 24
  }
}
